PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=auction_db

# Redis Configuration (Optional / Fallback)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
